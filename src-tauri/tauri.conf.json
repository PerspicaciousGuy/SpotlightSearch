{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gleam",
  "version": "0.1.0",
  "identifier": "io.github.perspicaciousguy.gleam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gleam",
        "width": 820,
        "height": 174,
        "minWidth": 480,
        "minHeight": 120,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "theme": "Light",
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "PerspicaciousGuy",
    "homepage": "https://github.com/PerspicaciousGuy/gleam",
    "copyright": "Copyright (c) 2026 PerspicaciousGuy",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Fast local file and app launcher",
    "longDescription": "Gleam searches the names of your files, folders and apps with a local index. Press Alt + Space, type, and press Enter. Nothing leaves your computer."
  }
}
